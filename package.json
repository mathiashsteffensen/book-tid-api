{
  "name": "book-tid-api",
  "version": "1.0.0",
  "description": "API Microservice part of the BOOK TID Architecture",
  "main": "server.js",
  "scripts": {
    "test": "NODE_ENV=test ts-mocha --require config/test.config.ts **/*.test.ts --timeout 10000",
    "build": "tsc --project ./",
    "clean": "sudo rm -r build",
    "start": "pm2-runtime start config/ecosystem.config.js --env production",
    "dev": "NODE_PATH=./ NODE_ENV=development nodemon server.ts",
    "stripeClearTests": "node api/admin/stripe/clearTests.mjs",
    "clearDevData": "npm run stripeClearTests && ts-node ./db/clearDB.ts",
    "lint": "eslint"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sendgrid/mail": "^7.4.1",
    "aws-sdk": "^2.804.0",
    "axios": "1.7.4",
    "bcrypt": "^5.0.0",
    "cookie-parser": "^1.4.5",
    "cors": "^2.8.5",
    "dayjs": "^1.9.7",
    "dotenv": "^8.2.0",
    "express": "5.0.0",
    "express-rate-limit": "^5.2.3",
    "express-validator": "^6.7.0",
    "handlebars": "4.7.7",
    "helmet": "^4.2.0",
    "jsonwebtoken": "9.0.0",
    "mongoose": "7.3.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.2",
    "multer-s3": "^2.9.0",
    "pm2": "^4.5.0",
    "stripe": "^8.127.0",
    "uniqid": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@stylistic/eslint-plugin": "^2.10.1",
    "@types/aws-sdk": "^2.7.0",
    "@types/bcrypt": "^3.0.0",
    "@types/cookie-parser": "^1.4.2",
    "@types/cors": "^2.8.10",
    "@types/express": "^4.17.11",
    "@types/express-rate-limit": "^5.1.1",
    "@types/jsonwebtoken": "^8.5.1",
    "@types/mocha": "^8.2.1",
    "@types/morgan": "^1.9.2",
    "@types/multer": "^1.4.5",
    "@types/multer-s3": "^2.7.9",
    "@types/node": "^14.14.34",
    "@types/uniqid": "^5.3.0",
    "chai": "^4.2.0",
    "chai-http": "^4.3.0",
    "eslint": "^9.14.0",
    "eslint-config-airbnb": "^19.0.4",
    "globals": "^15.12.0",
    "mocha": "10.1.0",
    "nodemon": "^2.0.6",
    "snyk": "1.1064.0",
    "ts-mocha": "^8.0.0",
    "ts-node": "10.9.2",
    "typescript": "4.7.4",
    "typescript-eslint": "^8.14.0"
  }
}
